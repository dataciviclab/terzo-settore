.env
__pycache__/
*.pyc

# Output toolkit — non versionare (raw/clean/mart/_runs rigenerabili)
out/

# Output operativi interni — non versionati
_local/

# Cache download RUNTS (XLSX snapshot scaricato dallo script)
datasets/runts/*.xlsx

# Open Cooperazione — raw intermediari e cache download (cf_mapping.csv resta committato)
datasets/open-cooperazione/raw_input.csv
datasets/open-cooperazione/data/raw_cache/

# Dashboard cache
dashboard/.streamlit/secrets.toml

# Output operativi (CSV, reporting) — tracciamo solo bandi
data/*
!data/bandi/
